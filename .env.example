# Application
APP_ENV=development
LOG_LEVEL=INFO
API_PUBLIC_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_PM_TILES_URL=http://localhost:8080/maps/valencia.pmtiles
NEXT_PUBLIC_MAP_ASSETS_URL=http://localhost:8080/maps

# PostgreSQL/PostGIS
POSTGRES_DB=aparca
POSTGRES_USER=aparca
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+asyncpg://aparca:change-me@db:5432/aparca

# API policy
CORS_ORIGINS=http://localhost:3000
CORS_ALLOW_ORIGIN_REGEX=^https://aparca-valencia(?:-[a-z0-9-]+)*\.vercel\.app$
RATE_LIMIT_PER_MINUTE=60
PARKING_CLUSTER_DISTANCE_METERS=12
DATA_STALE_AFTER_HOURS=48

# Municipal sources
ARCGIS_BASE_URL=https://geoportal.valencia.es/server/rest/services/OPENDATA/Trafico/MapServer
ARCGIS_UNREGULATED_LAYER_ID=197
ENABLE_REGULATED_PREDICTIONS=false

# Self-hosted geocoder
NOMINATIM_URL=http://nominatim:8080
NOMINATIM_USER_AGENT=AparcaValencia/0.1 (contact@example.invalid)
GEOCODER_CACHE_DAYS=30
GEOCODER_BBOX=-0.60,39.25,-0.15,39.70

# Production routing (example only)
PUBLIC_HOST=aparca-valencia.46-202-89-71.sslip.io
TRAEFIK_NETWORK=traefik-public
TRAEFIK_CERT_RESOLVER=letsencrypt
