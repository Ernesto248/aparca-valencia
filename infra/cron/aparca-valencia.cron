SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
CRON_TZ=Europe/Madrid

# Datos municipales diarios
15 2 * * * root cd /opt/aparca-valencia && docker compose -f compose.yaml -f compose.prod.yaml run --rm api python -m app.cli sync-unregulated >> /var/log/aparca-sync.log 2>&1

# Copia PostgreSQL diaria
45 2 * * * root /opt/aparca-valencia/infra/scripts/backup-postgres.sh >> /var/log/aparca-backup.log 2>&1

# Cartografía e índice Nominatim el primer domingo de mes, fuera de horas punta.
15 4 * * 0 root [ "$(date +\%d)" -le 7 ] && /opt/aparca-valencia/infra/scripts/refresh-osm-assets.sh >> /var/log/aparca-osm-refresh.log 2>&1
